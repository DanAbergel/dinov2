  dataset_path: ImageFolder:root=/sci/labs/arieljaffe/dan.abergel1/brain2d_tp_varied
  output_dir: /sci/labs/arieljaffe/dan.abergel1/runs/brain/tp_varied_full
  saveckp_freq: 20
  seed: 0
  num_workers: 8
  OFFICIAL_EPOCH_LENGTH: 150
  cache_dataset: true
  centering: centering
  cell_augmentation: false
student:
  arch: vit_small
  patch_size: 16
  drop_path_rate: 0.1
  layerscale: 1.0e-05
  drop_path_uniform: true
  pretrained_weights: ''
  ffn_layer: mlp
