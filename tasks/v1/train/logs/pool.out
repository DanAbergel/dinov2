  separate_head: false
  head_n_prototypes: 4096
  head_bottleneck_dim: 256
  head_nlayers: 3
  head_hidden_dim: 2048
train:
  batch_size_per_gpu: 2
  dataset_path: Mixed
  output_dir: /sci/labs/arieljaffe/dan.abergel1/runs/v1/pool
  saveckp_freq: 20
  seed: 42
  num_workers: 4
  OFFICIAL_EPOCH_LENGTH: 2300
  cache_dataset: false
  centering: sinkhorn_knopp
  cell_augmentation: false
  fmri_augmentation: true
  fmri_masking_only: true
  proportional_sampler: true
  proportional_quota: null
student:
  arch: vit_small
  patch_size: 9
  drop_path_rate: 0.1
  layerscale: 1.0e-05
  drop_path_uniform: true
