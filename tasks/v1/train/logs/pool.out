  warmup_teacher_temp: 0.04
  teacher_temp: 0.07
  warmup_teacher_temp_epochs: 5
  in_chans: 1
  channel_adaptive: false
optim:
  epochs: 10
  weight_decay: 0.04
  weight_decay_end: 0.4
  base_lr: 0.0003
  lr: 3.75e-05
  warmup_epochs: 0.3
  min_lr: 1.0e-06
  clip_grad: 3.0
