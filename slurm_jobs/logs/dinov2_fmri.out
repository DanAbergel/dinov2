  Config snapshot (fMRI overrides):
      dataset_path: HCP                   # resolves to HCPFullScanDataset in _parse_dataset_str
      batch_size_per_gpu: 2               # 2 full scans/GPU: KoLeo needs >=2 CLS per chunk to compute NN distance
      OFFICIAL_EPOCH_LENGTH: 1000         # ~ N_subjects with batch 1; tune to your subject count
      centering: "sinkhorn_knopp"
      fmri_augmentation: true             # NEW; triggers MultiCrop3D + (T_eff, N_spatial) MaskingGenerator
      arch: vit_small
      patch_size: 9                       # spatial Conv3d kernel/stride
      num_register_tokens: 4
      in_chans: 1
      pretrained_weights: "/sci/labs/arieljaffe/dan.abergel1/checkpoints/dinov2_vits14_reg4_fmri_init.pth"
      fmri_mode: true
      fmri_img_size: [45, 54, 45]         # HCP downsampled volume; patch=9 -> 5*6*5 = 150 spatial tokens
      fmri_temporal_size: 1200            # full HCP REST1_LR scan; tune for ADNI (140) etc.
      fmri_temporal_kernel: 20            # non-overlapping temporal Conv1d -> T_eff = 60 (was 10 -> T_eff=120 but 18k tokens caused attention OOM on H200)
      in_chans: 1
      epochs: 20
      base_lr: 3.0e-4                     # base; effective LR = base_lr * sqrt(batch/1024). Yoni's linear-scaling guidance with batch=2 would prescribe ~5e-6; sqrt_wrt_1024 gives us ~1.3e-5 — close enough and matches DINOv2 official convention.


