        buffer_dtype: fp32
dino:
  loss_weight: 1.0
  head_n_prototypes: 128
  head_bottleneck_dim: 256
  head_nlayers: 3
  head_hidden_dim: 2048
  koleo_loss_weight: 0
ibot:
  loss_weight: 1.0
  mask_sample_probability: 0.5
  mask_ratio_min_max:
  - 0.1
  - 0.5
  separate_head: false
  head_n_prototypes: 128
  head_bottleneck_dim: 256
  head_nlayers: 3
  head_hidden_dim: 2048
train:
  batch_size_per_gpu: 16
  dataset_path: ImageFolder:root=/sci/labs/arieljaffe/dan.abergel1/data/imagenette/imagenette2-320/train
  output_dir: /sci/labs/arieljaffe/dan.abergel1/runs/imagenette/tt002
  saveckp_freq: 20
  seed: 0
  num_workers: 8
  OFFICIAL_EPOCH_LENGTH: 100
  cache_dataset: true
  centering: centering
  cell_augmentation: false
student:
  arch: vit_small
  patch_size: 16
  drop_path_rate: 0.1
  layerscale: 1.0e-05
  drop_path_uniform: true
  pretrained_weights: ''
  ffn_layer: mlp
  block_chunks: 4
  qkv_bias: true
  proj_bias: true
  ffn_bias: true
  num_register_tokens: 0
  interpolate_antialias: false
  interpolate_offset: 0.1
  in_chans: 3
  channel_adaptive: false
teacher:
  momentum_teacher: 0.992
  final_momentum_teacher: 1
  warmup_teacher_temp: 0.02
  teacher_temp: 0.02
  warmup_teacher_temp_epochs: 2
  in_chans: 3
  channel_adaptive: false
optim:
  epochs: 20
  weight_decay: 0.04
  weight_decay_end: 0.4
  base_lr: 0.01
  lr: 0.00125
  warmup_epochs: 1
  min_lr: 1.0e-06
  clip_grad: 3.0
  freeze_last_layer_epochs: 0
  scaling_rule: sqrt_wrt_1024
  patch_embed_lr_mult: 0.2
  layerwise_decay: 0.9
  adamw_beta1: 0.9
  adamw_beta2: 0.999
crops:
  global_crops_scale:
  - 0.32
  - 1.0
  local_crops_number: 8
  local_crops_scale:
  - 0.05
  - 0.32
  global_crops_size: 224
  local_crops_size: 96
evaluation:
  eval_period_iterations: 0

